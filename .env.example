# ══════════════════════════════════════════════════════════════════════════════
# Auto-Director — Environment Configuration
# Copy this file to .env and fill in your keys.
# All fields are optional — omitting them activates DEMO (offline) mode.
# ══════════════════════════════════════════════════════════════════════════════

# ── AI Provider Keys ──────────────────────────────────────────────────────────
GEMINI_API_KEY=           # Enables: Gemini scene breakdown + Gemini image gen
ELEVENLABS_API_KEY=       # Enables: ElevenLabs natural TTS
GOOGLE_TTS_API_KEY=       # Enables: Google Cloud TTS (fallback if ElevenLabs absent)

# ── Video Output ──────────────────────────────────────────────────────────────
VIDEO_WIDTH=1080           # px  (9:16 vertical)
VIDEO_HEIGHT=1920          # px
FPS=30

# ── Subtitle Mode ─────────────────────────────────────────────────────────────
# USE_WHISPER=false        # Set to true to use OpenAI Whisper for real word-level
                           # timestamp alignment (requires: pip install openai-whisper)

# ── Logging ───────────────────────────────────────────────────────────────────
# LOG_LEVEL=INFO           # DEBUG | INFO | WARNING | ERROR

# ── Retry ─────────────────────────────────────────────────────────────────────
# API_MAX_RETRIES=3
# API_BASE_DELAY=1.0       # seconds, doubled on each retry (exponential backoff)
